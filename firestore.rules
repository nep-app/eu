rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@jeep.app';
    }
    function isUser(username) {
      return request.auth != null && request.auth.token.email == username + '@jeep.app';
    }
    function callerUsername() {
      return request.auth.token.email.split('@')[0];
    }

    // GDPR consent (user reads own, admin reads all)
    match /users/{username} {
      allow read: if isUser(username) || isAdmin();
      allow write: if isUser(username) || isAdmin();
    }

    // Personal data
    match /userData/{username} {
      allow read, write: if isUser(username) || isAdmin();
    }

    // Todos (subcollection per user)
    match /todos/{username}/items/{itemId} {
      allow read, write: if isUser(username) || isAdmin();
    }

    // Events — any user can create/read; update/delete restricted to owner or admin
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if isAdmin()
        || resource.data.userId == callerUsername()
        || resource.data.userId == "all";
      allow delete: if isAdmin()
        || resource.data.userId == callerUsername()
        || resource.data.userId == "all";
    }

    // Forum — anyone can read, create, react/reply (update); only owner or admin can delete
    match /forum/{channel}/posts/{postId} {
      allow read, create, update: if request.auth != null;
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.username == callerUsername());
    }

    // Recursos — admin writes, authenticated users read
    match /recursos/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Messages to Teresa (authenticated write, admin read/update)
    match /messages/{msgId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
      allow update: if isAdmin();
    }

    // Suggestions (authenticated write, admin read)
    match /suggestions/{suggId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
    }

    // Medals (admin writes, users read their own)
    match /medals/{username} {
      allow read: if isUser(username) || isAdmin();
      allow write: if isAdmin();
    }

    // Configurações globais (Pergunta da Semana, etc)
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Notificações (Teresa e outros users criam, utilizador lê, apaga e atualiza)
    match /notifications/{username}/items/{notifId} {
      allow read, delete: if isUser(username) || isAdmin();
      allow create: if request.auth != null;
      allow update: if isUser(username) || isAdmin();
    }

    // Notificações admin (jovens criam ao completar ações, admin lê)
    match /adminNotificacoes/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // Agendados (publicações agendadas) — só o admin cria/lê/apaga.
    // A Cloud Function processarAgendados usa o Admin SDK (não passa aqui).
    match /agendados/{docId} {
      allow read, write: if isAdmin();
    }

    // Tokens de notificações push (cada utilizador guarda o token do seu
    // próprio dispositivo; as Cloud Functions usam o Admin SDK e não
    // passam por estas regras)
    match /fcmTokens/{username} {
      allow read, write: if isUser(username) || isAdmin();
    }

    // Polls / Votações (admin cria/apaga, todos votam)
    match /polls/{pollId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if request.auth != null;
    }

    // Missões semanais (admin cria/apaga, todos leem)
    match /missions/{missionId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Quizzes / Dilemas (admin cria/apaga, todos leem e respondem via userData)
    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Arquivo de perguntas semanais (admin cria e lê)
    match /perguntasArquivo/{docId} {
      allow read, write: if isAdmin();
    }

    // Satisfação anónima (qualquer autenticado cria, só admin lê)
    match /satisfacao/{docId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
    }

    // Fórum demo (isolado do fórum real) — mesmas restrições de delete
    match /forum_demo/{channel}/posts/{postId} {
      // Fórum de DEMONSTRAÇÃO isolado — qualquer autenticado pode apagar, para o
      // reset da demo limpar os posts a fingir (que são de vários "autores").
      allow read, create, update, delete: if request.auth != null;
    }

  }
}
